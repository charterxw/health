IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = targeted
TARGETED_DEVICE_FAMILY = 1
CODE_SIGN_STYLE = Automatic
CURRENT_PROJECT_VERSION = 10
MARKETING_VERSION = 1.3.0
APP_BUNDLE_IDENTIFIER = com.frankandpatrick.health
// Optional, local-only team / bundle ID overrides. Never commit credentials.
#include? "Local.xcconfig"

// Keep Swift compilation within the same bounded parallelism as the build.
OTHER_SWIFT_FLAGS = $(inherited) -j2
