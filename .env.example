OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=low

# Optional: send every completed analysis to a private Telegram chat.
TELEGRAM_NOTIFICATIONS_ENABLED=true
# Store the bot token and chat ID in secrets/telegram-bot-token and
# secrets/telegram-chat-id. Do not put the bot token in this file.

DASHBOARD_USER=admin
DASHBOARD_PASS=change-me
JWT_SECRET=replace-with-a-long-random-secret

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/api/auth/callback
# true for HTTPS deployments; false only for direct HTTP/LAN access
COOKIE_SECURE=true

# Production docker-compose.yml retains the Pi's current volume and network names.
# Set this to the replacement Pi's LAN IP when restoring on a different host.
HEALTH_BIND_ADDRESS=192.168.1.225

# Used by the portable ops/compose.standalone.yml (local HTTP example).
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ORIGINS=http://localhost:9999
ENABLE_BACKGROUND_JOBS=false

TZ=America/New_York
